+// [bf2mc patch] The play HUD laid out for a wide window. The title draws its HUD as 640x480 art, kept 4:3 in the
+// middle of the window, and big: built for a television across the room. Each draw's quads are grouped into the
+// pieces they make (quads within a few pixels of each other: a word, a gauge, the map), and each piece is scaled by
+// g_hud_scale. A piece that stays put (followed from frame to frame by its texture and place: an edge or its middle
+// keeps still each way, as when only its text changes; kSettleMs still, after the HUD slides in) and sits by a side
+// or a corner of the art is
+// scaled about that corner or side's middle, which also moves g_hud_edge of the way out to the window's edge (the
+// left and right; top and bottom are the window's already), so it keeps its shape and its margin shrinks with it.
+// A piece that moves again after settling (a marker over a soldier, a distance) is scaled about its own middle from
+// then on, and so is a new one until it settles. A still piece in the middle (the pause menu) is left as it is. The
+// vertices are moved in the draw's uploaded copy, write combined: read back from the source.
+void D3D12Backend::HudLayout(const Assembled& a, uint32_t buffer, uint8_t* dst) {
+    constexpr float kW = 640, kH = 480;
+    constexpr float kJoin = 6;       // pixels between quads of one piece
+    constexpr float kFollow = 40;    // pixels a piece's middle goes from one frame to the next and is still that piece
+    constexpr float kStill = 0.5f;   // pixels an edge may move and keep still
+    constexpr uint64_t kSettleMs = 400;
+    constexpr uint32_t kMaxQuads = 1024;
+    const VertexElement& pe = a.elements[0];
+    if (pe.format != DXGI_FORMAT_R32G32B32_FLOAT && pe.format != DXGI_FORMAT_R32G32B32A32_FLOAT) return;
+    const VertexBuffer& pb = a.buffers[buffer];
+    uint32_t n = a.vertex_count;
+    if (!pb.src || !pb.stride || n < 3 || uint64_t(n - 1) * pb.stride + pe.offset + 8 > pb.bytes) return;
+    uint32_t per = hud_quads_ && n % 4 == 0 ? 4 : n;  // a quad list's quads, else the draw as one
+    uint32_t quads = n / per;
+    if (quads > kMaxQuads) return;
+    auto src = [&](uint32_t v, float* xy) { std::memcpy(xy, pb.src + size_t(v) * pb.stride + pe.offset, 8); };
+    struct Box {
+        float x0, y0, x1, y1;
+        int piece;
+    };
+    static std::vector<Box> boxes;
+    boxes.resize(quads);
+    for (uint32_t q = 0; q < quads; q++) {
+        Box& b = boxes[q];
+        b = {1e30f, 1e30f, -1e30f, -1e30f, int(q)};
+        for (uint32_t v = q * per; v < q * per + per; v++) {
+            float p[2];
+            src(v, p);
+            b.x0 = std::min(b.x0, p[0]), b.y0 = std::min(b.y0, p[1]);
+            b.x1 = std::max(b.x1, p[0]), b.y1 = std::max(b.y1, p[1]);
+        }
+    }
+    // pieces: quads that touch (within kJoin) share one, the lowest index
+    auto root = [&](int i) {
+        while (boxes[size_t(i)].piece != i) i = boxes[size_t(i)].piece = boxes[size_t(boxes[size_t(i)].piece)].piece;
+        return i;
+    };
+    for (uint32_t i = 0; i < quads; i++)
+        for (uint32_t j = i + 1; j < quads; j++) {
+            const Box &p = boxes[i], &q = boxes[j];
+            if (p.x0 - kJoin > q.x1 || q.x0 - kJoin > p.x1 || p.y0 - kJoin > q.y1 || q.y0 - kJoin > p.y1) continue;
+            int ri = root(int(i)), rj = root(int(j));
+            if (ri != rj) boxes[size_t(std::max(ri, rj))].piece = std::min(ri, rj);
+        }
+    struct Piece {
+        float x0 = 1e30f, y0 = 1e30f, x1 = -1e30f, y1 = -1e30f;
+        float ox = 0, oy = 0, k = 1;  // p' = o + p * k
+    };
+    static std::vector<Piece> pieces;
+    pieces.assign(quads, Piece{});
+    for (uint32_t q = 0; q < quads; q++) {
+        Piece& p = pieces[size_t(root(int(q)))];
+        const Box& b = boxes[q];
+        p.x0 = std::min(p.x0, b.x0), p.y0 = std::min(p.y0, b.y0);
+        p.x1 = std::max(p.x1, b.x1), p.y1 = std::max(p.y1, b.y1);
+    }
+    // the pieces followed from frame to frame
+    struct Track {
+        uint32_t tex;
+        float x0, y0, x1, y1;
+        uint64_t still_ms, seen_frame;  // still since
+        bool settled, marker;  // has kept still kSettleMs; moved again after that
+    };
+    static std::vector<Track> tracks;
+    uint64_t now = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch()).count());
+    static uint64_t pruned = ~0ull;
+    if (pruned != frame_) {
+        pruned = frame_;
+        std::erase_if(tracks, [&](const Track& t) { return frame_ - t.seen_frame > 30; });
+    }
+    // the window's left edge in the art's pixels: the 2D squeeze shows the art 4:3 in the middle
+    float out = g_squeeze_2d > 0 && g_squeeze_2d < 1 ? kW * 0.5f * (1 / g_squeeze_2d - 1) : 0;
+    float k = std::clamp(g_hud_scale, 0.1f, 2.0f), edge = std::clamp(g_hud_edge, 0.0f, 1.0f) * out;
+    for (uint32_t q = 0; q < quads; q++) {
+        if (root(int(q)) != int(q)) continue;
+        Piece& p = pieces[q];
+        if (p.x1 - p.x0 > kW * 0.8f && p.y1 - p.y0 > kH * 0.8f) continue;  // full screen
+        float cx = (p.x0 + p.x1) * 0.5f, cy = (p.y0 + p.y1) * 0.5f;
+        // its track: the nearest of this texture seen lately, not yet matched this frame
+        Track* t = nullptr;
+        float best = kFollow * kFollow;
+        for (Track& c : tracks) {
+            if (c.tex != hud_tex_ || c.seen_frame == frame_) continue;
+            float dx = (c.x0 + c.x1) * 0.5f - cx, dy = (c.y0 + c.y1) * 0.5f - cy, d = dx * dx + dy * dy;
+            if (d < best) best = d, t = &c;
+        }
+        if (!t) {
+            tracks.push_back({hud_tex_, p.x0, p.y0, p.x1, p.y1, now, frame_, false, false});
+            t = &tracks.back();
+        } else {
+            // still: an edge or the middle keeps its place each way (text that changes keeps one of them)
+            auto keeps = [&](float a0, float a1, float b0, float b1) {
+                return std::fabs(a0 - b0) < kStill || std::fabs(a1 - b1) < kStill ||
+                       std::fabs((a0 + a1) - (b0 + b1)) < 2 * kStill;
+            };
+            bool still = keeps(t->x0, t->x1, p.x0, p.x1) && keeps(t->y0, t->y1, p.y0, p.y1);
+            if (!still) {
+                // the HUD slides in when the soldier spawns, then keeps still: what moves after settling is a marker
+                if (t->settled) t->marker = true;
+                t->still_ms = now;
+            }
+            t->x0 = p.x0, t->y0 = p.y0, t->x1 = p.x1, t->y1 = p.y1, t->seen_frame = frame_;
+        }
+        if (!t->marker && now - t->still_ms >= kSettleMs) t->settled = true;
+        bool fixed = t->settled && !t->marker;
+        int col = cx < kW / 3 ? 0 : cx > kW * 2 / 3 ? 2 : 1;
+        int row = cy < kH / 3 ? 0 : cy > kH * 2 / 3 ? 2 : 1;
+        float ax, ay, bx;  // about (ax, ay), which moves to (bx, ay)
+        if (!fixed) {
+            ax = bx = cx, ay = cy;
+        } else if (col == 1 && row == 1) {
+            continue;
+        } else {
+            ax = col * kW * 0.5f, ay = row * kH * 0.5f;
+            bx = ax + (col == 0 ? -edge : col == 2 ? edge : 0);
+        }
+        p.k = k;
+        p.ox = bx - ax * k;
+        p.oy = ay - ay * k;
+    }
+    for (uint32_t q = 0; q < quads; q++) {
+        const Piece& p = pieces[size_t(root(int(q)))];
+        if (p.k == 1 && p.ox == 0 && p.oy == 0) continue;
+        for (uint32_t v = q * per; v < q * per + per; v++) {
+            float xy[2];
+            src(v, xy);
+            xy[0] = p.ox + xy[0] * p.k;
+            xy[1] = p.oy + xy[1] * p.k;
+            std::memcpy(dst + size_t(v) * pb.stride + pe.offset, xy, 8);
+        }
+    }
+}
