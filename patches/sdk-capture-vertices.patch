+// [bf2mc patch] a 32 bit linear surface's guest memory as a top down bmp
+static void CapWriteGuestBmp(const std::filesystem::path& path, uint32_t data, uint32_t w, uint32_t h) {
+    FILE* f = _wfopen(path.c_str(), L"wb");
+    if (!f) return;
+    uint32_t pitch = (w * 4 + 63) & ~63u, size = w * h * 4;
+    uint8_t hd[54] = {'B', 'M'};
+    auto put = [&](int o, uint32_t v) { std::memcpy(hd + o, &v, 4); };
+    put(2, 54 + size);
+    put(10, 54);
+    put(14, 40);
+    put(18, w);
+    put(22, uint32_t(-int32_t(h)));
+    hd[26] = 1;
+    hd[28] = 32;
+    put(34, size);
+    fwrite(hd, 1, sizeof(hd), f);
+    const uint8_t* p = static_cast<const uint8_t*>(kernel::HostPtr(data));
+    for (uint32_t y = 0; y < h; y++) fwrite(p + size_t(y) * pitch, 1, w * 4, f);
+    fclose(f);
+}
