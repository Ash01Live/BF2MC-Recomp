diff --git a/runtime/gpu/d3d12.cpp b/runtime/gpu/d3d12.cpp
index beec183..6abcff6 100644
--- a/runtime/gpu/d3d12.cpp
+++ b/runtime/gpu/d3d12.cpp
@@ -670,6 +670,11 @@ private:
     ComPtr<ID3D12Device> dev_;
     ComPtr<ID3D12CommandQueue> queue_;
     ComPtr<IDXGISwapChain3> swap_;
+    HANDLE latency_ = nullptr;  // [bf2mc patch] signalled when the swap chain takes another frame (g_low_latency)
+    uint32_t SwapFlags() const {
+        return (tearing_ ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0) |
+               (g_low_latency ? DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT : 0);
+    }
     ComPtr<ID3D12Resource> bb_[kFrames];
     ComPtr<ID3D12Fence> fence_;
     HANDLE event_ = nullptr;
@@ -836,7 +841,7 @@ bool D3D12Backend::CreateSwapChain(HWND hwnd) {
     sd.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
     sd.BufferCount = kFrames;
     sd.SwapEffect = DXGI_SWAP_EFFECT_FLIP_DISCARD;
-    sd.Flags = tearing_ ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0;
+    sd.Flags = SwapFlags();
     ComPtr<IDXGISwapChain1> sc1;
     if (FAILED(factory_->CreateSwapChainForHwnd(queue_.Get(), hwnd, &sd, nullptr, nullptr, &sc1))) {
         LOGE("d3d12: no swap chain");
@@ -844,6 +849,17 @@ bool D3D12Backend::CreateSwapChain(HWND hwnd) {
     }
     factory_->MakeWindowAssociation(hwnd, DXGI_MWA_NO_ALT_ENTER);
     sc1.As(&swap_);
+    // [bf2mc patch] Low latency: at most one frame waits in the swap chain's queue. By default up to three did, so at
+    // the display's rate (166 fps on a 165 Hz screen) each frame was shown two or three refreshes after the game read
+    // the controller for it. Present waits until the queue has room, so the title's next frame, and its input, is
+    // taken as late as possible.
+    if (g_low_latency) {
+        ComPtr<IDXGISwapChain2> sc2;
+        if (SUCCEEDED(swap_.As(&sc2)) && SUCCEEDED(sc2->SetMaximumFrameLatency(1))) {
+            latency_ = sc2->GetFrameLatencyWaitableObject();
+            LOGI("d3d12: low latency swap chain, one frame queued");
+        }
+    }
     return true;
 }
 
@@ -3131,7 +3147,7 @@ void D3D12Backend::ResizeSwap() {
         if (f.fence) WaitFence(f.fence);
     }
     for (auto& b : bb_) b.Reset();
-    swap_->ResizeBuffers(kFrames, w, h, DXGI_FORMAT_B8G8R8A8_UNORM, tearing_ ? DXGI_SWAP_CHAIN_FLAG_ALLOW_TEARING : 0);
+    swap_->ResizeBuffers(kFrames, w, h, DXGI_FORMAT_B8G8R8A8_UNORM, SwapFlags());
     CreateBackBufferViews();
     bb_w_ = w;
     bb_h_ = h;
@@ -3346,6 +3362,9 @@ void D3D12Backend::Present(const Surface& front) {
     bool vsync = app::Get().vsync;
     auto perf_swap = PerfClock::now();
     swap_->Present(vsync ? 1 : 0, !vsync && tearing_ ? DXGI_PRESENT_ALLOW_TEARING : 0);
+    // [bf2mc patch] until the swap chain takes another frame; bounded, so a lost signal costs a frame, not a hang
+    constexpr DWORD kLatencyWaitMs = 100;
+    if (latency_) WaitForSingleObjectEx(latency_, kLatencyWaitMs, FALSE);
     g_perf.swap += PerfMs(perf_swap);
 
     presents_++;
