+    // [bf2mc patch] Vertex memory the title rewrites every frame (particles, sprites) is read by the render thread after
+    // the title has moved on and refilled it for other quads: smoke and light cones flickered or stretched across the
+    // screen. A vertex buffer whose bytes behind the same draw change is marked dynamic; from then on each of its
+    // draws up to kSnapMax bytes is copied now into a ring the render thread reads instead, through a header copy.
+    static constexpr uint32_t kSnapRing = 4u << 20, kSnapHalf = kSnapRing / 2, kSnapMax = 64u << 10;
+
+    static uint64_t Fingerprint(const uint8_t* p, uint32_t n) {
+        uint64_t h = 1469598103934665603ull ^ n;
+        auto mix = [&](const uint8_t* q, uint32_t m) {
+            for (uint32_t i = 0; i < m; i++) h = (h ^ q[i]) * 1099511628211ull;
+        };
+        uint32_t edge = std::min<uint32_t>(n, 64);
+        mix(p, edge);
+        if (n > edge) mix(p + n - edge, edge);
+        if (n > 256) mix(p + n / 2, 64);
+        return h;
+    }
+
+    uint32_t SnapCopy(const void* src, uint32_t n) {
+        if (!snap_) {
+            snap_ = mem::AllocContiguous(kSnapRing, 32u << 20, mem::kPhysicalSize - 1, 0x1000);
+            if (!snap_) snap_ = mem::AllocContiguous(kSnapRing, 0, 0xFFFFFFFF, 0x1000);
+            if (!snap_) return 0;
+        }
+        uint32_t room = (n + 63) & ~63u;
+        uint32_t pos = snap_pos_ + room > kSnapRing ? 0 : snap_pos_;
+        uint32_t from = snap_pos_ ? (snap_pos_ - 1) / kSnapHalf : 1, to = (pos + room - 1) / kSnapHalf;
+        if (to != from) {
+            snap_fence_[from] = Fence();
+            Wait(snap_fence_[to], WaitFor::Resource, nullptr);
+        }
+        std::memcpy(kernel::HostPtr(snap_ + pos), src, n);
+        snap_pos_ = pos + room;
+        return snap_ + pos;
+    }
+
+    void PrepareSnapshots(const State& s, uint32_t start, uint32_t count, const uint8_t* indices) {
+        snap_on_ = false;
+        if (!count) return;
+        uint32_t lo, hi;
+        if (indices) {
+            const uint16_t* ix = reinterpret_cast<const uint16_t*>(indices);
+            uint16_t a = 0xFFFF, b = 0;
+            for (uint32_t i = 0; i < count; i++) {
+                a = std::min(a, ix[i]);
+                b = std::max(b, ix[i]);
+            }
+            lo = a + s.base_vertex;
+            hi = b + s.base_vertex;
+        } else {
+            lo = start;
+            hi = start + count - 1;
+        }
+        if (hi < lo) return;
+        if (snap_seen_.size() > 200000) snap_seen_.clear();
+        for (size_t i = 0; i < s.streams.size(); i++) {
+            snap_override_[i] = 0;
+            const auto& st = s.streams[i];
+            if (!st.vb || !st.stride || (kernel::R32(st.vb) & 0x70000) != 0) continue;  // vertex buffers
+            uint64_t bytes = uint64_t(hi - lo + 1) * st.stride + 16;
+            if (bytes > kSnapMax) continue;
+            uint32_t pa = kernel::R32(st.vb + 4);
+            uint64_t base = uint64_t(lo) * st.stride;
+            const uint8_t* src = static_cast<const uint8_t*>(kernel::HostPtr(mem::VirtualFromPhysical(pa) + uint32_t(base)));
+            if (!dynamic_.count(st.vb)) {
+                uint64_t key = uint64_t(st.vb) << 32 ^ (uint64_t(pa) + base);
+                uint64_t h = Fingerprint(src, uint32_t(bytes));
+                auto [it, fresh] = snap_seen_.try_emplace(key, h);
+                bool changed = !fresh && it->second != h;
+                it->second = h;
+                if (!changed) continue;
+                dynamic_.insert(st.vb);
+            }
+            uint32_t at = SnapCopy(src, uint32_t(bytes));
+            if (!at) continue;
+            uint32_t pa_copy = mem::PhysicalFromVirtual(at);
+            if (pa_copy < base) continue;
+            uint8_t hdr[kHeaderBytes] = {};
+            std::memcpy(hdr, kernel::HostPtr(st.vb), 12);
+            uint32_t data = pa_copy - uint32_t(base);
+            std::memcpy(hdr + 4, &data, 4);
+            snap_override_[i] = Scratch(hdr, kHeaderBytes);
+            snap_on_ = true;
+        }
+    }
+
     // resources by guest header: the batch that last read them
     void Use(uint32_t header) {
         if (!header) return;
@@ -466,6 +559,13 @@ private:
     std::array<Recent<uint64_t>, 64> recent_uses_{};
     uint32_t ring_ = 0;
