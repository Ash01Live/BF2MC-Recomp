+    // [bf2mc patch] snapshots of dynamic vertex memory
+    uint32_t snap_ = 0, snap_pos_ = 0;
+    uint64_t snap_fence_[2] = {};
+    std::unordered_map<uint64_t, uint64_t> snap_seen_;  // buffer and range start to the bytes last seen there
+    std::unordered_set<uint32_t> dynamic_;              // vertex buffer headers the title rewrites
+    uint32_t snap_override_[16] = {};
+    bool snap_on_ = false;
     Batch* cur_ = nullptr;
     State sent_;  // the state as the render thread will have it
     std::unordered_map<uint32_t, uint64_t> last_use_;
