+// [bf2mc patch] HUD art the title magnifies, shown at its own pixel size. The HUD is 640x480 art scaled to the window's
+// height (three host pixels a console pixel at 1440p), so art the title already draws larger than its texture (the
+// crosshair at 2.5 console pixels a texel, the mission text at about 2) came out as big blocks. Such a draw (a list of
+// axis aligned quads whose first quad shows a texel over at least 1.5 console pixels both ways) is scaled about the
+// middle of all its quads to g_hud_native host pixels a texel down, the same across. The rest of the HUD is drawn
+// near one texel a console pixel and is left as it is.
+void D3D12Backend::HudNative(const State& s, GuestExtent size, DrawConstants& c) {
+    constexpr float kMagnified = 1.5f;      // console pixels a texel from which a draw counts as magnified
+    constexpr uint32_t kMaxVertices = 4096;
+    constexpr uint32_t kMinTexture = 16;    // smaller: a solid colour, not art
+    const Assembled& a = asm_;
+    if (a.topology != Topology::Triangles || a.vertex_count < 4 || a.vertex_count > kMaxVertices || !bound_rt_) return;
+    if (!(a.regs & 1)) return;
+    const VertexElement& pe = a.elements[0];
+    if (pe.format != DXGI_FORMAT_R32G32B32_FLOAT && pe.format != DXGI_FORMAT_R32G32B32A32_FLOAT) return;
+    int uvr = -1;
+    for (int r = 1; r < 16 && uvr < 0; r++)
+        if ((a.regs >> r & 1) && a.elements[size_t(r)].format == DXGI_FORMAT_R32G32_FLOAT) uvr = r;
+    if (uvr < 0) return;
+    const VertexElement& te = a.elements[size_t(uvr)];
+    const VertexBuffer& pb = a.buffers[pe.buffer];
+    const VertexBuffer& tb = a.buffers[te.buffer];
+    if (!pb.src || !tb.src || !pb.stride || !tb.stride) return;
+    uint32_t n = a.vertex_count;
+    if (uint64_t(n - 1) * pb.stride + pe.offset + 8 > pb.bytes || uint64_t(3) * tb.stride + te.offset + 8 > tb.bytes) return;
+    TextureDesc td;
+    if (!s.textures[0] || !Describe(s.textures[0], td) || td.width < kMinTexture || td.height < kMinTexture) return;
+    auto pos = [&](uint32_t v, float* xy) { std::memcpy(xy, pb.src + size_t(v) * pb.stride + pe.offset, 8); };
+    auto uv = [&](uint32_t v, float* st) { std::memcpy(st, tb.src + size_t(v) * tb.stride + te.offset, 8); };
+    float p0[2], p1[2], p2[2], t0[2], t1[2], t2[2];
+    pos(0, p0), pos(1, p1), pos(2, p2), uv(0, t0), uv(1, t1), uv(2, t2);
+    // the first quad: an edge across, then one down
+    if (std::fabs(p1[1] - p0[1]) > 0.01f || std::fabs(p2[0] - p1[0]) > 0.01f) return;
+    float du = std::fabs(t1[0] - t0[0]) * td.width, dv = std::fabs(t2[1] - t1[1]) * td.height;
+    if (du < 1 || dv < 1) return;
+    float magx = std::fabs(p1[0] - p0[0]) / du, magy = std::fabs(p2[1] - p1[1]) / dv;
+    if (!(magx >= kMagnified && magy >= kMagnified)) return;
+    float lo[2] = {1e30f, 1e30f}, hi[2] = {-1e30f, -1e30f};
+    for (uint32_t v = 0; v < n; v++) {
+        float p[2];
+        pos(v, p);
+        for (int i = 0; i < 2; i++) lo[i] = std::min(lo[i], p[i]), hi[i] = std::max(hi[i], p[i]);
+    }
+    float host = float(bound_rt_->h) / float(size.h);  // host pixels a console pixel
+    // one scale both ways, from the height: the title draws some art wider than its texels (the crosshair, the mission
+    // text's letters), and that shape is kept
+    c.hud[0] = c.hud[1] = std::min(1.0f, g_hud_native / (host * magy));
+    c.hud[2] = (lo[0] + hi[0]) * 0.5f;
+    c.hud[3] = (lo[1] + hi[1]) * 0.5f;
+}
