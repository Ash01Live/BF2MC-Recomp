+// [bf2mc patch] ultrawide: the frame is stretched across the window's width, so targets get the scale that gives
+// one host pixel per window pixel across (more than enough down, which the present shrinks)
+static float UltrawideScale(uint32_t gw, uint32_t gh) {
+    if (!g_ultrawide || !app::Widescreen() || !gw || !gh) return 1;
+    app::Mode m = app::Output();
+    float across = float(m.width) / std::max(m.height, 1u) * float(gh) / float(gw);  // host x per host y
+    return std::max(across, 1.0f);
+}
