+// [bf2mc patch] SSAO. ao: from the frame's depth, each pixel's position in view space (the projection's tangents
+// across and down, near and far), a normal from its neighbours, and 12 samples on a disk of a fixed size in the
+// world around it: how much of the hemisphere above the surface they cover (the Alchemy estimator), faded with
+// distance. Into an R8 target. composite: a depth aware 4x4 blur of it, multiplied into the frame.
+const char* kSsaoHlsl = R"(
+Texture2D<float> t0 : register(t0);
+Texture2D<float> t1 : register(t1);
+cbuffer B : register(b1) { float4 p0; float4 p1; };  // w h tanx tany, near far radius strength
+struct O { float4 p : SV_Position; float2 uv : TEXCOORD0; };
+O vs(uint id : SV_VertexID) {
+    O o;
+    o.uv = float2((id << 1) & 2, id & 2);
+    o.p = float4(o.uv * float2(2, -2) + float2(-1, 1), 0, 1);
+    return o;
+}
+float Lin(float d) { return p1.x * p1.y / (p1.y - d * (p1.y - p1.x)); }
+float3 Pos(Texture2D<float> dt, int2 px) {
+    float z = Lin(dt.Load(int3(clamp(px, int2(0, 0), int2(p0.xy) - 1), 0)));
+    float2 ndc = (float2(px) + 0.5) / p0.xy * float2(2, -2) + float2(-1, 1);
+    return float3(ndc.x * p0.z * z, ndc.y * p0.w * z, z);
+}
+float ao(O i) : SV_Target {
+    int2 px = int2(i.p.xy);
+    float d = t0.Load(int3(px, 0));
+    if (d >= 0.99999) return 1;
+    float3 P = Pos(t0, px);
+    // the normal from the nearer neighbour each way, so edges keep their own side
+    float3 l = Pos(t0, px - int2(1, 0)), r = Pos(t0, px + int2(1, 0));
+    float3 u = Pos(t0, px - int2(0, 1)), b = Pos(t0, px + int2(0, 1));
+    float3 dx = abs(r.z - P.z) < abs(P.z - l.z) ? r - P : P - l;
+    float3 dy = abs(b.z - P.z) < abs(P.z - u.z) ? b - P : P - u;
+    float3 N = normalize(cross(dy, dx));
+    if (dot(N, P) > 0) N = -N;
+    float rpx = clamp(p1.z / (P.z * p0.z) * p0.x * 0.5, 3, 160);
+    float spin = frac(52.9829189 * frac(dot(float2(px), float2(0.06711056, 0.00583715)))) * 6.2831853;
+    float occ = 0;
+    [unroll] for (int k = 0; k < 12; k++) {
+        float t = (k + 0.5) / 12;
+        float a = spin + k * 2.3999632;  // golden angle
+        int2 q = px + int2(float2(cos(a), sin(a)) * rpx * t);
+        float3 v = Pos(t0, q) - P;
+        float vv = dot(v, v);
+        float f = saturate(1 - vv / (p1.z * p1.z));
+        occ += max(dot(v, N) - 0.002 * P.z, 0) / (vv + 0.0001) * f;
+    }
+    occ = occ * 2 * p1.z / 12;
+    return saturate(1 - p1.w * occ);
+}
+float4 composite(O i) : SV_Target {
+    int2 px = int2(i.p.xy);
+    float z = Lin(t1.Load(int3(px, 0)));
+    float sum = 0, wsum = 0;
+    [unroll] for (int y = -2; y < 2; y++)
+        [unroll] for (int x = -2; x < 2; x++) {
+            int2 q = clamp(px + int2(x, y), int2(0, 0), int2(p0.xy) - 1);
+            float w = 1 / (0.0001 + abs(Lin(t1.Load(int3(q, 0))) - z) / z * 40);
+            w = min(w, 1);
+            sum += t0.Load(int3(q, 0)) * w;
+            wsum += w;
+        }
+    float a = wsum > 0 ? sum / wsum : 1;
+    return float4(a, a, a, 1);
+}
+)";
