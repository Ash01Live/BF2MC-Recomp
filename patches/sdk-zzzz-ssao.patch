+// [bf2mc patch] SSAO's two pipelines: the occlusion into R8, the blurred occlusion multiplied into a target of fmt
+ID3D12PipelineState* D3D12Backend::EnsureSsaoPipeline(bool composite, DXGI_FORMAT fmt) {
+    uint64_t key = 0x55A0000000000000ull | (composite ? 0x100000000ull : 0) | uint64_t(fmt);
+    auto& pso = blit_psos_[key];
+    if (pso) return pso.Get();
+    uint64_t h;
+    ID3DBlob* vs = Compile(kSsaoHlsl, "vs", "vs_5_0", h);
+    ID3DBlob* ps = Compile(kSsaoHlsl, composite ? "composite" : "ao", "ps_5_0", h);
+    if (!vs || !ps) return nullptr;
+    D3D12_GRAPHICS_PIPELINE_STATE_DESC p{};
+    p.pRootSignature = root_.Get();
+    p.VS = {vs->GetBufferPointer(), vs->GetBufferSize()};
+    p.PS = {ps->GetBufferPointer(), ps->GetBufferSize()};
+    p.SampleMask = UINT_MAX;
+    p.RasterizerState.FillMode = D3D12_FILL_MODE_SOLID;
+    p.RasterizerState.CullMode = D3D12_CULL_MODE_NONE;
+    p.RasterizerState.DepthClipEnable = TRUE;
+    auto& bt = p.BlendState.RenderTarget[0];
+    bt.RenderTargetWriteMask = D3D12_COLOR_WRITE_ENABLE_ALL;
+    if (composite) {
+        // the frame times the occlusion; its alpha kept
+        bt.BlendEnable = TRUE;
+        bt.SrcBlend = D3D12_BLEND_ZERO;
+        bt.DestBlend = D3D12_BLEND_SRC_COLOR;
+        bt.BlendOp = D3D12_BLEND_OP_ADD;
+        bt.SrcBlendAlpha = D3D12_BLEND_ZERO;
+        bt.DestBlendAlpha = D3D12_BLEND_ONE;
+        bt.BlendOpAlpha = D3D12_BLEND_OP_ADD;
+    }
+    p.PrimitiveTopologyType = D3D12_PRIMITIVE_TOPOLOGY_TYPE_TRIANGLE;
+    p.NumRenderTargets = 1;
+    p.RTVFormats[0] = composite ? fmt : DXGI_FORMAT_R8_UNORM;
+    p.SampleDesc.Count = 1;
+    if (FAILED(dev_->CreateGraphicsPipelineState(&p, IID_PPV_ARGS(&pso)))) {
+        LOG_FIRST(1, "ssao: no pipeline");
+        return nullptr;
+    }
+    return pso.Get();
+}
+
+// [bf2mc patch] SSAO once a frame, while playing, as the first person gun or the first 2D draw (depth test ALWAYS:
+// the HUD) comes to a frame sized target after the frame's 3D (depth tested) draws: the world is done, the gun and
+// the HUD not yet drawn
+void D3D12Backend::MaybeSsao(const State& s) {
+    if (!bound_rt_ || !bound_ds_ || ssao_frame_ == frame_) return;
+    uint32_t gw, gh;
+    SurfaceSize(s.rt, gw, gh);
+    if (gw != guest_w_ || gh != guest_h_ || !s.rs[kRsZEnable]) return;
+    if (SimpleState(s, kMZFunc) != 0x207) {
+        // the first person gun (drawn zoomed apart from the world, as the ultrawide patch tells them apart) comes
+        // after the world: the occlusion goes in before it, so the gun and arms get none
+        bool gun = false;
+        if (gun_frame_ == frame_ && world_zoom_ > 0) {
+            const auto& r = s.vsc;
+            auto len = [](const std::array<float, 4>& x) { return std::sqrt(x[0] * x[0] + x[1] * x[1] + x[2] * x[2]); };
+            float w = len(r[4]), zoom = w > 0 ? len(r[2]) / w : 0;
+            gun = zoom > 0 && std::fabs(zoom - world_zoom_) > world_zoom_ * 0.02f;
+        }
+        if (!gun) {
+            world_frame_ = frame_;
+            return;
+        }
+    }
+    if (world_frame_ != frame_) return;
+    uint64_t now = uint64_t(std::chrono::duration_cast<std::chrono::milliseconds>(
+                                std::chrono::steady_clock::now().time_since_epoch()).count());
+    if (now - g_hud_play_ms.load(std::memory_order_relaxed) > 250) return;
+    ssao_frame_ = frame_;
+    DrawSsao(*bound_rt_, *bound_ds_);
+    bound_rt_ = bound_ds_ = nullptr;
+}
+
+void D3D12Backend::DrawSsao(Target& rt, Target& ds) {
+    ID3D12PipelineState* ao = EnsureSsaoPipeline(false, DXGI_FORMAT_R8_UNORM);
+    ID3D12PipelineState* comp = EnsureSsaoPipeline(true, rt.fmt);
+    if (!ao || !comp || rt.w != ds.w || rt.h != ds.h) return;
+    if (!ssao_rtv_heap_) {
+        D3D12_DESCRIPTOR_HEAP_DESC hd{D3D12_DESCRIPTOR_HEAP_TYPE_RTV, 1, D3D12_DESCRIPTOR_HEAP_FLAG_NONE, 0};
+        if (FAILED(dev_->CreateDescriptorHeap(&hd, IID_PPV_ARGS(&ssao_rtv_heap_)))) return;
+    }
+    if (!ssao_rt_ || ssao_w_ != rt.w || ssao_h_ != rt.h) {
+        if (ssao_rt_) Release(ssao_rt_);
+        ssao_rt_.Reset();
+        D3D12_HEAP_PROPERTIES hp{D3D12_HEAP_TYPE_DEFAULT};
+        D3D12_RESOURCE_DESC td{};
+        td.Dimension = D3D12_RESOURCE_DIMENSION_TEXTURE2D;
+        td.Width = rt.w;
+        td.Height = rt.h;
+        td.DepthOrArraySize = 1;
+        td.MipLevels = 1;
+        td.Format = DXGI_FORMAT_R8_UNORM;
+        td.SampleDesc.Count = 1;
+        td.Flags = D3D12_RESOURCE_FLAG_ALLOW_RENDER_TARGET;
+        if (FAILED(dev_->CreateCommittedResource(&hp, D3D12_HEAP_FLAG_NONE, &td, D3D12_RESOURCE_STATE_RENDER_TARGET,
+                                                 nullptr, IID_PPV_ARGS(&ssao_rt_)))) {
+            return;
+        }
+        ssao_state_ = D3D12_RESOURCE_STATE_RENDER_TARGET;
+        dev_->CreateRenderTargetView(ssao_rt_.Get(), nullptr, ssao_rtv_heap_->GetCPUDescriptorHandleForHeapStart());
+        ssao_w_ = rt.w, ssao_h_ = rt.h;
+    }
+    if (cap_) fprintf(cap_, "%04u ssao\n", cap_i_++);
+    float tan_y = std::max(g_view_tan.load(std::memory_order_relaxed), 0.05f);
+    float c[8] = {float(rt.w), float(rt.h), tan_y * display_aspect_, tan_y,
+                  g_view_near.load(), g_view_far.load(), g_ssao_radius, g_ssao_strength * (g_ssao.load() == 2 ? 1.6f : 1.0f)};
+    // the occlusion
+    Transition(ds.res.Get(), ds.state, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    Transition(ssao_rt_.Get(), ssao_state_, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    D3D12_CPU_DESCRIPTOR_HANDLE ah = ssao_rtv_heap_->GetCPUDescriptorHandleForHeapStart();
+    cl_->OMSetRenderTargets(1, &ah, FALSE, nullptr);
+    SetFullViewport(rt.w, rt.h);
+    uint32_t slot = AllocSrvSlots(2);
+    D3D12_SHADER_RESOURCE_VIEW_DESC sv{};
+    sv.Format = DXGI_FORMAT_R24_UNORM_X8_TYPELESS;
+    sv.ViewDimension = D3D12_SRV_DIMENSION_TEXTURE2D;
+    sv.Shader4ComponentMapping = D3D12_DEFAULT_SHADER_4_COMPONENT_MAPPING;
+    sv.Texture2D.MipLevels = 1;
+    dev_->CreateShaderResourceView(ds.res.Get(), &sv, Cpu(srv_heap_.Get(), slot, srv_inc_));
+    dev_->CreateShaderResourceView(ds.res.Get(), &sv, Cpu(srv_heap_.Get(), slot + 1, srv_inc_));
+    Alloc cb = Upload(256, 256);
+    std::memcpy(cb.cpu, c, sizeof(c));
+    DrawFullScreen(ao, cb.gpu, slot);
+    // blurred, into the frame
+    Transition(ssao_rt_.Get(), ssao_state_, D3D12_RESOURCE_STATE_PIXEL_SHADER_RESOURCE);
+    Transition(rt.res.Get(), rt.state, D3D12_RESOURCE_STATE_RENDER_TARGET);
+    D3D12_CPU_DESCRIPTOR_HANDLE rh = Cpu(rtv_heap_.Get(), rt.view, rtv_inc_);
+    cl_->OMSetRenderTargets(1, &rh, FALSE, nullptr);
+    uint32_t slot2 = AllocSrvSlots(2);
+    D3D12_SHADER_RESOURCE_VIEW_DESC av = sv;
+    av.Format = DXGI_FORMAT_R8_UNORM;
+    dev_->CreateShaderResourceView(ssao_rt_.Get(), &av, Cpu(srv_heap_.Get(), slot2, srv_inc_));
+    dev_->CreateShaderResourceView(ds.res.Get(), &sv, Cpu(srv_heap_.Get(), slot2 + 1, srv_inc_));
+    DrawFullScreen(comp, cb.gpu, slot2);
+    rt.drawn = true;
+}
