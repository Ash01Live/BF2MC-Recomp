+// [bf2mc patch] one element's copy into the repacked layout
+struct PackElement {
+    const uint8_t* src;
+    uint32_t src_stride;
+    uint32_t dst;
+    uint32_t copy;
+    uint32_t slot;  // the dword aligned room it has, cleared first when the copy is shorter
+};
+
+// vertex by vertex with a fixed size copy per element; seq: the vertices in draw order, null for the range from first
+void FillPacked(const PackElement* el, int nregs, uint32_t n, uint32_t stride, uint32_t first, const uint32_t* seq,
+                uint8_t* dst) {
+    for (uint32_t v = 0; v < n; v++) {
+        uint32_t id = seq ? seq[v] : first + v;
+        uint8_t* o = dst + size_t(v) * stride;
+        for (int k = 0; k < nregs; k++) {
+            const PackElement& e = el[k];
+            const uint8_t* src = e.src + size_t(id) * e.src_stride;
+            uint8_t* to = o + e.dst;
+            switch (e.copy) {
+                case 4: std::memcpy(to, src, 4); continue;
+                case 8: std::memcpy(to, src, 8); continue;
+                case 12: std::memcpy(to, src, 12); continue;
+                case 16: std::memcpy(to, src, 16); continue;
+                default: break;
+            }
+            std::memset(to, 0, e.slot);
+            switch (e.copy) {
+                case 1: to[0] = src[0]; break;
+                case 2: std::memcpy(to, src, 2); break;
+                case 3: std::memcpy(to, src, 3); break;
+                case 6: std::memcpy(to, src, 6); break;
+                default: std::memcpy(to, src, e.copy); break;
+            }
+        }
+    }
+}
+
+// [bf2mc patch] Repacked vertices kept between frames. Most of the level is the same vertices every frame, though
+// not always at the same address (dynamic vertex buffers are drawn from snapshot copies, see render_thread.cpp):
+// entries are found by the layout and a hash of the bytes the draw reads, which is several times cheaper than
+// repacking them. A copy is kept from the second time the same bytes are seen, so vertices that change every frame
+// cost a hash and a small entry; an address whose bytes keep changing skips the hash for a while. Entries are dropped
+// least recently used first, a few per draw, once unused for a few seconds or past the memory limit: never all at once.
+constexpr uint32_t kPackCacheMinVertices = 32;
+constexpr size_t kPackCacheBytes = size_t(256) << 20;
+constexpr size_t kPackCacheEntries = 200000;
+constexpr uint64_t kPackCacheIdleDraws = 1u << 20;  // a few seconds of draws
+constexpr uint32_t kPackVolatileSkips = 64;          // draws a changing address is repacked without the hash
+constexpr uint32_t kPackAddressSlots = 4096;
+
+class PackCache {
+public:
+    // layout: the repacked layout and vertex count; address: where the draw reads, for the changing-bytes check
+    template <typename HashFn, typename FillFn>
+    const uint8_t* Find(uint64_t layout, uint64_t address, HashFn content, size_t bytes, FillFn fill) {
+        draw_++;
+        Trim();
+        Address& a = addresses_[address % kPackAddressSlots];
+        if (a.key == address && a.skip) {
+            a.skip--;
+            return nullptr;
+        }
+        uint64_t h = content();
+        if (a.key != address) a = {address, h, 0, 0};
+        else if (a.hash != h) {
+            a.hash = h;
+            if (++a.misses >= 3) {
+                a.misses = 0;
+                a.skip = kPackVolatileSkips;
+            }
+        } else {
+            a.misses = 0;
+        }
+        uint64_t key = Hash(&h, sizeof(h), layout);
+        auto it = map_.find(key);
+        if (it == map_.end()) {
+            // first sight: remembered, not kept
+            lru_.push_front({key, nullptr, 0, draw_});
+            map_[key] = lru_.begin();
+            return nullptr;
+        }
+        Entry& e = *it->second;
+        lru_.splice(lru_.begin(), lru_, it->second);
+        e.used = draw_;
+        if (e.data && e.bytes == bytes) return e.data.get();
+        total_ -= e.bytes;
+        e.data.reset(new uint8_t[bytes]);
+        e.bytes = bytes;
+        total_ += bytes;
+        fill(e.data.get());
+        return e.data.get();
+    }
+
+private:
+    struct Entry {
+        uint64_t key;
+        std::unique_ptr<uint8_t[]> data;
+        size_t bytes;
+        uint64_t used;
+    };
+    struct Address {
+        uint64_t key = 0, hash = 0;
+        uint32_t misses = 0, skip = 0;
+    };
+    // a few of the least recently used a draw
+    void Trim() {
+        for (int i = 0; i < 4 && !lru_.empty(); i++) {
+            Entry& e = lru_.back();
+            bool old = draw_ - e.used > kPackCacheIdleDraws;
+            if (!old && total_ <= kPackCacheBytes && map_.size() <= kPackCacheEntries) break;
+            total_ -= e.bytes;
+            map_.erase(e.key);
+            lru_.pop_back();
+        }
+    }
+    std::list<Entry> lru_;
+    std::unordered_map<uint64_t, std::list<Entry>::iterator> map_;
+    Address addresses_[kPackAddressSlots];
+    size_t total_ = 0;
+    uint64_t draw_ = 0;
+};
+PackCache g_pack_cache;
