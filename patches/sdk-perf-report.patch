+
+#include "core/diag.h"
 #include "gpu/vertex.h"
 
 #include <algorithm>
@@ -276,8 +280,16 @@ bool RawReadable(const State& s, const Inputs& inputs) {
         bool readable = he.format && stride && stride % kStrideAlign == 0 && in.offset < kElementOffsetEnd &&
                         in.offset % std::min<uint32_t>(he.bytes, 4) == 0;
         if (!readable) {
-            LOG_FIRST(32, "vertex: converted on the CPU: v%d type %02X offset %u stride %u", inputs.regs[k], in.type,
-                      in.offset, stride);
+            // [bf2mc patch] reported with XBE_PERF, each distinct case once
+            if (diag::Perf()) {
+                static std::mutex m;
